config("jbig2enc_warnings") {
  cflags_cc = [
    "-Wno-unused-variable",
    "-Wno-unused-parameter",
    "-Wno-unused-but-set-variable",
    "-Wno-unused-function",
    "-Wno-sign-compare",
    "-Wno-deprecated-declarations",
    "-Wno-implicit-int-conversion",
    "-Wno-format-pedantic",
    "-Wno-format-security",
    "-Wno-shorten-64-to-32",
    "-Wno-c++-compat",
    "-Wno-c++11-narrowing",
    "-Wno-shift-op-parentheses",
    "-Wno-extra-semi",
    "-Wno-missing-field-initializers",
  ]
}

config("jbig2enc_config") {
  include_dirs = [
    "src",
    "../leptonica/src",
  ]
  defines = [
    "HAVE_LIBPNG=0",
    "HAVE_LIBJPEG=0",
    "HAVE_LIBTIFF=0",
    "HAVE_LIBGIF=0",
    "HAVE_LIBJP2K=0",
    "HAVE_LIBWEBP=0",
    "HAVE_LIBZ=0",
    "VERSION=\"hyper-internal\"",
  ]

  if (is_win) {
    defines += [
      "HAVE_FMEMOPEN=0",
      "WIN32",
      "NOMINMAX",
      "WIN32_LEAN_AND_MEAN",
      "_USE_MATH_DEFINES",
      "_CRT_SECURE_NO_WARNINGS",
    ]
  } else {
    defines += [ "HAVE_FMEMOPEN=1" ]
  }
}

source_set("jbig2enc") {
  configs += [ ":jbig2enc_warnings", ":jbig2enc_config" ]
  public_configs = [ ":jbig2enc_config" ]
  cflags_cc = [
    "-fvisibility=hidden",
    "-fno-strict-aliasing",
  ]
  sources = [
    "src/jbig2arith.cc",
    "src/jbig2comparator.cc",
    "src/jbig2enc.cc",
    "src/jbig2sym.cc",
  ]
  deps = [ "../leptonica:leptonica" ]
  if (is_win) {
    libs = [ "ws2_32.lib" ]
  }
  visibility = [ "//fpdfsdk:*" ]
}
